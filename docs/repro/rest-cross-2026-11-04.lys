// A lower voice's rest under an upper voice with @cross notes: bar 1 with @cross, bar 2 the same notes without it.
title "rest-cross"
octave absolute
time 2/4
key c major

part rh { clef treble }
part lh { clef bass }

section Piece {
  rh {
    e''2 |
    e''2 |
  }
  lh {
    voice { tuplet 3/2 { d8 g8@cross b8@cross } tuplet 3/2 { d8 g8@cross b8@cross } } { g,8 r8 g,8 r8 } |
    voice { tuplet 3/2 { d8 g8 b8 } tuplet 3/2 { d8 g8 b8 } } { g,8 r8 g,8 r8 } |
  }
}

form { ~Piece }

score {
  grandStaff {
    staff rh "Right"
    staff lh "Left"
  }
}
