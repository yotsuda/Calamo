// The truth of the fair set (S59) for Paul Lacombe, Esquisses et souvenirs Op.28 No.1: written from the Hamelle print
// (1878, IMSLP #958979, data/fair/lacombe28-1/hamelle), bar by bar. Never to debug the reader on.
// As the print has them: bars 16, 30 and 60 are three groups of three eighths in each voice with no number and no
// bracket (bare triplets, the only reading that fills the bar); bars 15/29/59 leave the left hand silent after one
// eighth (no rests printed); the last two chords of bar 30/60 and bars 31-32/61-62 are under an 8va line (written here
// as they sound). Bars 1-32 are played once, bars 33-62 are repeated (||: before bar 33, :|| at the end).
title "Esquisses et souvenirs I"
tempo "Moderato." 4 = 176
octave absolute
paper { breaksOnly }
time 3/4
key des major

part rh { clef treble }
part lh { clef bass }

section A {
  rh {
    r4@p f''8@text("con eleganza")( aes''8) bes''8 r8 |
    des'''2.@accent( |
    c'''4) ges''4@staccato( ges''4@staccato) |
    ges''2. |
    r4 f''8( aes''8) bes''8@staccato r8 |
    f'''2.@accent( | break
    ees'''4) g''4@staccato( g''4@staccato) |
    g''2. |
    r4 ges''8@cresc( aes''8) bes''8@!cresc r8 |
    aes'''2@accent( ges'''4) |
    <aes'' f'''>2( <ges'' ees'''>4) |
    <ges'' ees'''>2( <f'' des'''>4) | break
    <ees'' c'''>2( <des'' bes''>4) |
    <des'' bes''>4. <aes' f''>8( <c'' aes''>4~) |
    voice { <c'' aes''>8 ees''8( ges''8@cresc d''8 f''8 ees''8) } { s8 ges'8( bes'8 f'8 aes'8 ges'8) } |
    voice { tuplet 3/2 bare { ges''8( e''8 g''8@!cresc } tuplet 3/2 bare { f''8@text("poco rit.") aes''8@decresc f''8 } tuplet 3/2 bare { aes''8 bes''8 des'''8@!decresc) } } { tuplet 3/2 bare { bes'8( g'8 bes'8 } tuplet 3/2 bare { aes'8 c''8 aes'8 } tuplet 3/2 bare { c''8 des''8 f''8) } } | break
    tempo "a tempo" voice { c'''8@p r8 ges''4 ges''4 } { ges''8 s8 a'8( bes'8@cresc) bes'8( b'8@!cresc) } |
    voice { ges''2. } { b'8( c''8) c''8( ces''8@decresc) ces''8( bes'8@!decresc) } |
    r4 f''8( aes''8) bes''8 r8 |
    f'''2.@accent( |
    voice { ees'''8) r8 g''4 g''4 } { s4 bes'8( b'8) b'8( c''8) } | break
    voice { g''2. } { c''8@cresc des''8@!cresc des''8( d''8) d''8( f''8) } |
    r4 ges''8@cresc( aes''8) aes''8( bes''8@!cresc) |
    aes'''2@accent( ges'''4) |
    <aes'' f'''>2( <ges'' ees'''>4) |
    <ges'' ees'''>2( <f'' des'''>4) | break
    <ees'' c'''>2( <des'' bes''>4) |
    <des'' bes''>4.@f <aes' f''>8( <c'' aes''>4~) |
    voice { <c'' aes''>8 ees''8( ges''8 d''8 f''8 ees''8) } { s8 ges'8( bes'8 f'8 aes'8 ges'8) } |
    voice { tuplet 3/2 bare { ges''8@text("dim. e rit.")( e''8 g''8 } tuplet 3/2 bare { f''8 aes''8@decresc c'''8 } tuplet 3/2 bare { f'''8) <c''' aes'''>8@8va <f''' c''''>8@!decresc } } { tuplet 3/2 bare { bes'8( g'8 bes'8 } tuplet 3/2 bare { aes'8 c''8 f''8 } tuplet 3/2 bare { aes''8) s4 } } | pageBreak
    voice { aes'''2( c'''4) } { <ges'' c''' f''' aes'''>2.@arpeggio@pp } |
    voice { aes'''2( des'''4@!8va) } { <f'' ees''' aes'''>2.@arpeggio } |
  }
  lh {
    des4@staccato <aes des' f'>4 r4 |
    r4 <aes des' f'>4 <aes des' f'>4 |
    ees4 <aes c' ges'>4 r4 |
    r4 <aes c' ges'>4 aes,4 |
    des4 <aes des' f'>4 r4 |
    r4 <aes des' f'>4 <aes des' f'>4 | break
    bes,4 <des' ees' g'>4 r4 |
    r4 <des' ees' g'>4 bes,4 |
    c4 <aes ees' ges'>4 r4 |
    r4 clef treble ges'8@cresc( aes'8 bes'8@!cresc) r8 |
    clef bass aes,4@text("cresc.") <aes c' ges'>4 r4 |
    bes,4 des'8( ees'8 f'8) r8 | break
    ees4 <des' ees' g'>4 r4 |
    aes,4 <aes des' f'>4 r4 |
    aes,8 s8 s2 |
    s2. | break
    ees4 <aes c' ges'>4 r4 |
    r4 <aes ees' ges'>4 aes,4 |
    des4 <aes des' f'>4 r4 |
    r4 <aes des' f'>4 <aes des' f'>4 |
    bes,4 <des' ees' g'>4 r4 | break
    r4 <des' ees' g'>4 bes,4 |
    c4 <aes ees' ges'>4 r4 |
    r4 clef treble ges'8( aes'8) aes'8( bes'8) |
    clef bass aes,4 <aes c' ges'>4 r4 |
    bes,4@text("cresc.") des'8( ees'8) ees'8( f'8) | break
    ees4 <des' ees' g'>4 r4 |
    aes,4 <aes des' f'>4 r4 |
    aes,8 s8 s2 |
    s2 s8 r8 | pageBreak
    aes,4 <aes c' ges'>4 r4 |
    r4 <aes des' f'>4 des4 |
  }
}

section B {
  rh {
    R2. |
    r4 c''8( ees''8 f''8) r8 |
    <des''~ c'''>2( <des'' bes''>4) |
    R2. | break
    r4 c''8( ees''8 f''8) r8 |
    <des''~ c'''>2( <des'' bes''>4) |
    R2. |
    r4 c''8( ees''8 ges''8) r8 |
    bes''4( ges''8 ees''8) c''8( ees''8 |
    ges''8 bes''8 ges''8 ees''8@text("cresc.")) c''8( ees''8 | break
    ges''8 a''8 ges''8 ees''8) c''8( ees''8 |
    ges''8 a''8 ges''8 ees''8) c''8( des''8 |
    d''8 ees''8 e''8 f''8 ges''8 g''8 |
    aes''8@text("poco rit.") a''8 bes''8@decresc b''8 c'''8 des'''8@!decresc) | break
    tempo "a tempo" voice { c'''8@p r8 ges''4 ges''4 } { s4 a'8( bes'8) bes'8( b'8) } |
    voice { ges''2. } { b'8( c''8) c''8( ces''8) ces''8( bes'8) } |
    r4 f''8( aes''8) bes''8 r8 |
    f'''2.@accent( |
    voice { ees'''8) r8 g''4 g''4 } { s4 bes'8( b'8) b'8( c''8) } | break
    voice { g''2. } { c''8 des''8 des''8( d''8) d''8( f''8) } |
    r4 ges''8@cresc( aes''8) aes''8( bes''8@!cresc) |
    aes'''2@accent( ges'''4) |
    <aes'' f'''>2( <ges'' ees'''>4) |
    <ges'' ees'''>2( <f'' des'''>4) | break
    <ees'' c'''>2( <des'' bes''>4) |
    <des'' bes''>4.@f <aes' f''>8( <c'' aes''>4~) |
    voice { <c'' aes''>8 ees''8( ges''8@text("dim.") d''8 f''8 ees''8) } { s8 ges'8( bes'8 f'8 aes'8 ges'8) } |
    voice { tuplet 3/2 bare { ges''8@text("e rit.")( e''8 g''8 } tuplet 3/2 bare { f''8 aes''8@decresc c'''8 } tuplet 3/2 bare { f'''8) <c''' aes'''>8@8va <f''' c''''>8@!decresc } } { tuplet 3/2 bare { bes'8( g'8 bes'8 } tuplet 3/2 bare { aes'8 c''8 f''8 } tuplet 3/2 bare { aes''8) s4 } } |
    voice { aes'''2( c'''4) } { <ges'' c''' f''' aes'''>2.@arpeggio@pp } |
    voice { aes'''2( des'''4@!8va) } { <f'' ees''' aes'''>2.@arpeggio } |
  }
  lh {
    tempo "a tempo" aes,4@staccato@p c'8( ees'8 f'8) r8 |
    aes'2.@accent( |
    g'4) <ees des'>4 <ees des'>4 |
    aes,4@staccato c'8( ees'8 f'8) r8 | break
    aes'2.@accent( |
    g'4) <ees des'>4 <ees des'>4 |
    aes,4@staccato clef treble c'8( ees'8 ges'8) r8 |
    bes'4.@accent( ges'8 ees'8) r8 |
    c'4( ees'8 ges'8) bes'8( ges'8 |
    ees'8 c'8 ees'8 ges'8) bes'8( ges'8 | break
    ees'8 c'8 ees'8 ges'8) a'8( ges'8 |
    ees'8 c'8 ees'8 ges'8) a'8( bes'8 |
    b'8 c''8 des''8 d''8 ees''8 e''8 |
    f''8 ges''8 g''8 aes''8 a''8 bes''8) | break
    clef bass ees4 <aes c' ges'>4 r4 |
    r4 <aes ees' ges'>4 aes,4 |
    des4 <aes des' f'>4 r4 |
    r4 <aes des' f'>4 <aes des' f'>4 |
    bes,4 <des' ees' g'>4 r4 | break
    r4 <des' ees' g'>4 bes,4 |
    c4 <aes ees' ges'>4 r4 |
    r4 clef treble ges'8( aes'8) aes'8( bes'8) |
    clef bass aes,4 <aes c' ges'>4 r4 |
    bes,4@text("cresc.") des'8( ees'8) ees'8( f'8) | break
    ees4 <des' ees' g'>4 r4 |
    aes,4 <aes des' f'>4 r4 |
    aes,8 s8 s2 |
    s2 s8 r8 |
    aes,4@staccato <aes ees' ges'>4@staccato r4 |
    r4 <aes des' f'>4@staccato des,4@staccato |
  }
}

form { ~A |: ~B :| }

score {
  grandStaff {
    staff rh "Piano right"
    staff lh "Piano left"
  }
}
