    <aes' c'' f''>8@f <aes' c'' ees''>8 <c'' ees'' aes''>8 <ees'' aes'' c'''>8 <aes'' c''' ees'''>4 <aes' ees''>4@p~ |
    voice { <aes' ees''>4 des''8( c''8) c''4.( bes'8) } { s4 aes'4 f'4( g'4) } | pageBreak
    <c' ees' aes'>4 r4 c'8( e'8 aes'8 c''8) |
    voice { aes'4@p( f'4) des''4( e'4) } { c'2 des'2 } | break
    voice { f'4 f'8( aes'8) aes'8( g'8) g'8 bes'8 } { c'4 r4 des'2 } |
    voice { des''4.( bes'8 aes'4) r4 } { e'2 f'4 s4 } |
    voice { ees''4( aes'4) c''4( bes'4~ } { ees'2 f'2 } | break
    voice { bes'8) f''8 ees''8( des''8 c''8 bes'8 aes'8 g'8) } { f'2( e'4) c'8( bes8) } |
    voice { f'4 g'4 c''8( c'8 d'8 e'8) } { aes4 des'4 c'4 bes4 } |
    voice { a'4@pp( f'4) d''4( e'4) } { <c' f'>2 c'2 } | break
    voice { a''4( f''4) <d'' d'''>4( e''4) } { c''2 c''2 } |
    <bes' c''~ g''>1 |
    <a' c'' f''>4 <f' a' c'' f'' a'' c''' f'''>2@pp r4 |
  }
  lh {
    <f' a'>2 <f' g' bes'>2 |
    <f' a'>4 <c' bes'>4. <c' bes'>8 <c' a'>8 <c' g'>8 |
    <c'~ f'>2( <c' e'>4) r4 | break
