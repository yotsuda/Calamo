// The truth of the fair set (S59) for Georges Hüe, Six Mélodies (Heine) No.1: written from the Leduc print
// (c.1886, the 1991 reprint scanned, IMSLP #994220, data/fair/hue-melodies1/leduc), bar by bar. Never to debug the reader on.
// As the print has them: bar 17's voice is a quarter and seven eighths; the three g'' are taken as a triplet with no
// number (the only reading that fills the bar).
title "Six Melodies I"
tempo "Andantino grazioso."
octave absolute
paper { breaksOnly }
time 4/4
key f major

part voice_ { clef treble }
part rh { clef treble }
part lh { clef treble pedal text }

section Piece {
  voice_ {
    R1 |
    R1 |
    R1 | break
    a'8 a'8 f'4 d''8 d''8 e'8 e'8 |
    f'4 f'8 a'8 a'8 g'8 g'8 bes'8 | break
    d''4.( bes'8) a'4 r4 |
    g'8 g'8 c''8 c''8 a'4 b'8@cresc c''8 |
    d''8 e''8 f''2@!cresc f''4~ | pageBreak
    f''8@text("Espress.").up e''8 d''8 c''8 b'4 a'8 b'8 |
    d''8 c''8 g''2@text("Poco rall.").up b'8 d''8 |
    tempo "A tempo" c''2 r2 | break
    R1 |
    tempo "Plus animé." r8 a'8 a'8 a'8 c''4. c''8 |
    d''8 d''8 a'8 a'8 c''4 bes'8 r8 | break
    r8 bes'8 c''8 d''8 ees''8 ees''8 f''8 ees''8 |
    ees''4( d''8) r8 r8 d''8 e''8 f''8 |
    e''4 e''8 e''8 tuplet 3/2 { g''8 g''8 g''8 } f''8 e''8 | break
    f''4. r8 r8 f''8@f@text("Avec passion.").up g''8 aes''8 |
    aes''4 ees''4 r4@text("Dim.").up ees''4~ |
    ees''4 des''8@text("Rall.").up( c''8) f''4. g'8 | pageBreak
    tempo "1° Tempo." aes'2 r2 |
    r4 r8 f'8@p e'8 e'8 g'8 g'8 | break
    f'2 aes'8 g'8 g'8 bes'8 |
    bes'2 aes'4 r8 aes'8 |
    aes'4 bes'8 c''8 c''4 bes'8 r8 | break
    r8 f''8 ees''8 des''8 c''8 bes'8 aes'8 g'8 |
    f'4 g'8 g'8 c''2~ |
    tempo "Andante." c''2 r2 | break
    tempo "Très simplement." a'8 a'8 f'4 d''8 d''8 e'8 e'8 |
    g'1@text("Rall.").up |
    f'4 r4 r2 |
  }
  lyrics fr { | | | J'ai rê- vé d'une en- fant de | roi aux joues pâ- les et hu- | mi- des: | nous é- tions as- sis sous les | til- leuls verts et | nous nous te- nions a- mou- | reu- se- ment em- bras- | sés. | | Je ne veux pas le | trô- ne de ton pè- re, | je ne veux pas son scep- tre | d'or, je ne veux | pas sa cou- ron- ne de di- a- | mants, je veux toi | mê- me, toi, | fleur de beau- | té! | Ce- la ne se peut | pas, me ré- pon- dit | el- le, j'ha- | bi- te la tom- be, | et je ne peux ve- nir à | toi que la nuit, | | et je viens par- ce- que je | t'ai- | me! | }
  rh {
    voice { a''4@p( f''4) d'''4( e''4) } { c''2 d''2 } |
    <c'' f''>4 <c'' e'' a''>4. <c'' e'' g''>8 <c'' f''>8 <c'' e''>8 |
    <bes'~ d''>2( <bes' c''>4) r4 | break
