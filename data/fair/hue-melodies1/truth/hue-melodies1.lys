    <e' g'>2. <g b f'>4 |
    voice { <g c' e'>4 bes'4@cresc( a'4 f'4@!cresc) } { s4 c'2. } | break
    voice { d''4( e'4) g'4( f'8) r8 } { d'4 c'8( bes8) bes4 a8 r8 } |
    voice { a'4( c''4) c'4( g'4) } { c'2 c'2 } |
    voice { a'2 a'4 g'8 r8 } { g'4 fis'4~ fis'8 d'8 g'8 bes'8 } | break
