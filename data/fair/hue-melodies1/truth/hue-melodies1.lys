    voice { a2. g4 } { f2 ees2 } |
    voice { s2 c'4( bes8) r8 } { <d c'>2 g2 } | break
    <d bes>2 <c c'>4 <f c'>4 |
    voice { c'4( bes4) <f a d'>2 } { <bes, f>2@arpeggio s2 } |
    voice { d'4( e'8 d'8) d'4 cis'4 } { g2 a2 } | break
