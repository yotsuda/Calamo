    voice { g'4 f'8( ees'8) ees'4( des'4) } { s2 ees2 } | pageBreak
    aes,8( ees8 aes8 c'8) aes4 e4 |
    <f aes>2 <f g>2 | break
    voice { aes4 aes8( c'8) c'8( bes8) bes8 g8 } { f4 r4 f2 } |
    voice { g4( bes8 des'8 c'4) r4 } { f2~ f4 f4 } |
    voice { aes2. g8( aes8) } { c2 des2 } | break
    <g, des bes>2@arpeggio <c g>4 <c e>4 |
    <des f>4 <bes, e>4 <aes, f>4 <g, c>4 |
    <f, c a>2@arpeggio@sustain <f, c bes>2@arpeggio@sustain | break
    clef treble <c' f' a'>2@!sustain <c' g' bes'>2 |
