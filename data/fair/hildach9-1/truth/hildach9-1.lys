section C {
  key g minor
  tempo "langsam"
  voice_ {
    d''4@p d''4 d''4 |
    g''4 d''8( d''8) d''4 |
    ees''4 c''8 d''8 ees''4 |
    d''4 g'4 r8 d''8 | break
    c''4. ees''8 d''8 c''8 |
    bes'4 g'8( a'8) bes'4 |
    a'4 a'4. a'8 |
    a'4 d'4 d''8@p d''8 || break
  }
  rh {
    s2. |
    s2. |
    s2. |
    s2. | break
    s2. |
    s2. |
    r8 a8 ees'8 g'8 <a e'>8 g'8 |
    <a d' fis'>4 r8 <e' fis' c''>8 <d' fis' b'>8 <c' fis' a'>8 || break
  }
  lh {
    voice { <bes d'>8@p <a c'>8 <g bes>8 <a c'>8 <bes d'>8 <c' ees'>8 } { r4 d2 } { g,2. } |
    voice { <bes d'>8 <a c'>8 <g bes>8 <a c'>8 <bes d'>8 g8 } { r4 d2 } { g,2. } |
    voice { <c' ees'>8 <bes d'>8 <a c'>8 <bes d'>8 <c' ees'>8 fis8 } { r4 ees2 } { g,2. } |
    voice { <bes d'>8 <a c'>8 <g bes>8 <a c'>8 <bes d'>8 g8 } { r4 d2 } { g,2. } | break
    voice { c'8 b8 c'8 ees'8 d'8 c'8 } { c,4 <c ees g>2 } |
    voice { bes8 a8 g8 a8 bes8 g8 } { d,4 <bes, d>2 } |
    c2 cis4 |
    d4 d,2 || break
  }
}

section D {
  key g major
  tempo "nach und nach langsamer"
  voice_ {
    d''4 d''4 d''4 |
    g''4 d''4 r4 |
    d''2 tuplet 3/2 { d''8 d''8 d''8 } |
    d''2 d''4 |
    d''4 d''4 d''4 | break
    d''8 e''8 d''4 r8 d'8@p |
    d'4 d'4. d'8 |
    g'2.~ |
    g'4 r4 r4 |
    R2.@fermata |]
  }
  rh {
    <b d' g'>2@p tuplet 3/2 { <c' fis' a'>8( <d' fis' b'>8 <e' fis' c''>8) } |
    <d' g' b'>2 g'4 |
    voice { <c' e'>4 <d' fis'>4. a'8 } { c'2 c'4 } |
    <b d'>2. |
    <c' fis' a'>4 <d' fis' b'>4 <e' fis' c''>4 | break
    <d' g' b'>2 g'4 |
    voice { <c' e'>4 <d' fis'>4. g'8~ } { s2 c'4 } |
    voice { g'2 e'4 } { b2 c'8 a8 } |
    voice { g'2~ g'8 g'8 } { b4 c'4 a4 } |
    <b g' d''>2.@arpeggio@fermata |]
  }
  lh {
    voice { r8 d4 d4 d8~ } { g,2. } |
    voice { d8 d4 d4 d8~ } { g,2. } |
    voice { d8 d4 d4 d8~ } { g,2. } |
    voice { d8 d4 d4 d8~ } { g,2. } |
