    voice { d8 d4 d4 d8~ } { g,2. } | break
    voice { d8 d4 d4 d8~ } { g,2. } |
    voice { d8 d4 d4 d8~ } { g,2. } |
    voice { d8 d4 d4 d8~ } { g,2. } |
    voice { d2 r4 } { g,2@fermata s4 } | pageBreak
    voice { r8 g8~ <g b>8 g'8 fis'8 dis'8 } { s4 g4 a4 } { <e, b,>2. } |
    voice { r8 g8~ <g b>8 g'8 fis'8 dis'8 } { s4 g4 a4 } { <e, b,>2. } |
    voice { r8 a8 dis'8 a'8 fis'8 dis'8 } { s4 a2 } { <e, c>2. } |
    voice { r8 g8 b8 g'8 fis'8 e'8 } { s4 g2 } { <e, b,>2. } |
    voice { r8 a8 c'8 fis'8 e'8 c'8 } { <d, c>2. } | break
    voice { r8 e8 g8 c'8 b8 g8 } { <b,, b,>2. } |
    voice { r8 fis8 a8 c'8 b8 a8 } { <b,, b,>2. } |
    voice { r8 g8~ <g b>8 g'8 fis'8 dis'8 } { s4 g4 a4 } { <e, b,>2. } |
