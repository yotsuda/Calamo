// The truth of the fair set (S66) for Eugen Hildach, 3 Lieder Op.9 No.1, Auf dem Dorf in den Spinnstuben (high
// voice): written from the Heinrichshofen print (Magdeburg 1891, IMSLP #706241, data/fair/hildach9-1/heinrichshofen),
// bar by bar. Never to debug the reader on. Heads named with tools/fair-truth/heads.py and settled by zoom.
// A head shared by two voices (one stem up, one stem down) is written in both voices, as in the earlier truths.
title "Auf dem Dorf in den Spinnstuben."
subtitle "At the village loom spinning."
composer "Eugen Hildach, Op.9 No 1."
tempo "Ruhig, aber nicht zu langsam."
octave absolute
paper { breaksOnly }
time 3/4

part voice_ { clef treble }
part rh { clef treble }
part lh { clef bass }

section A {
  key g minor
  voice_ {
    R2. |
    R2. |
    R2. |
    R2. | break
    R2. |
    R2. |
    R2. |
    r4 r4 d''8@mf d''8 | break
    d''4 d''4 d''4 |
    g''4 d''8( d''8) d''4 |
    ees''4 c''8 d''8 ees''4 |
    d''4 g'4 r8 d''8 | break
    c''4. ees''8 d''8 c''8 |
    bes'4 g'8( a'8) bes'4 |
    a'4 a'4. a'8 | pageBreak
    a'4 d'4 r8 d''8 |
    d''4 d''4 d''4 |
    g''4 d''4 d''8 d''8 |
    ees''4 c''8 d''8 ees''4 | break
    d''4 r4 d''4 |
    g''8 f''8 ees''8 d''8 c''8 bes'8 |
    a'8 bes'8 c''4 ees''4 |
    d''4 fis'4. g'8 || break
  }
  rh {
    <bes' d''>8@mf <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 <c'' ees''>8 |
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 g'8 |
    <c'' ees''>8 <bes' d''>8 <a' c''>8 <bes' d''>8 <c'' ees''>8 fis'8 |
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 g'8 | break
    voice { c''8 b'8 c''8 ees''8 d''8 c''8 } { r4 g'2~ } |
    voice { bes'8 a'8 g'8 a'8 bes'8 g'8 } { g'4 g'2 } |
    a'8 g'8 ees'8 a8 <e' g' a'>8 a8 |
    voice { <d' fis' a'>4~ <d' fis' a'>4. r8 } { d'8 a8~ a4. s8 } | break
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 <c'' ees''>8 |
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 g'8 |
    <c'' ees''>8 <bes' d''>8 <a' c''>8 <bes' d''>8 <c'' ees''>8 fis'8 |
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 g'8 | break
    c''8 b'8 <g' c''>8 ees''8 d''8 c''8 |
    bes'8 a'8 g'8 a'8 bes'8 g'8 |
    voice { a'2 a'4 } { r8 <ees' g'>4 <ees' g'>4 <e' g'>8 } | pageBreak
    voice { a'4. <ees' c''>8 <d' bes'>8 <c' a'>8 } { r8 <d' fis'>4~ fis'4. } |
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 <c'' ees''>8 |
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 g'8 |
    <c'' ees''>8 <bes' d''>8 <a' c''>8 <bes' d''>8 <c'' ees''>8 fis'8 | break
    <bes' d''>8 <a' c''>8 <g' bes'>8 <a' c''>8 <bes' d''>8 g'8 |
    s2 g'8( c''8~ |
    <g' c'' g''>2) r4 |
    voice { s4 fis'8 d''8~ <fis' d''>4 } { r8 c'8 c'4~ c'4 } || break
  }
  lh {
    voice { r4 d2 } { g,2. } |
    voice { r4 d2 } { g,2. } |
    voice { r4 ees2 } { g,2. } |
    voice { r4 d2 } { g,2. } | break
    c4 <g c' ees'>2 |
    d4 <g bes d'>2 |
    c2 cis4 |
    d4 d,4. r8 | break
    voice { r4 d2 } { g,2. } |
    voice { r4 d2 } { g,2. } |
    voice { r4 ees2 } { g,2. } |
    voice { r4 d2 } { g,2. } | break
    c4 <g c' ees'>2 |
    d4 <g bes d'>2 |
    c2 cis4 | pageBreak
    d4 d,2 |
    voice { r4 d2 } { g,2. } |
    voice { r4 d2 } { g,2. } |
    voice { r4 ees2 } { g,2. } | break
    voice { r4 d2 } { g,2. } |
    c8( g8 c'8 ees'8) s4 |
    <c g c' ees'>2 r4 |
    r4 grace { d,8 } d2 || break
  }
}

