    r8@p <g' g''>8 <g' g''>8 <bes' bes''>8 <f' f''>4 |
    r8 <g' g''>8 <g' g''>8 <bes' bes''>8 <f' f''>4 |
    r8 <g' g''>8 <d'' d'''>8 <c'' c'''>8 <bes' bes''>8 <f' f''>16 <g' g''>16 |
    <ees' ees''>4 <ees'' g'' ees'''>8@arpeggio r8 r4 | break
